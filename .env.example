# Local defaults. The container apps receive the Azure values from Bicep; nothing here is a secret.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_ACCOUNT_ENDPOINT=https://<account>.services.ai.azure.com/
CHAT_DEPLOYMENT=gpt-5-mini
SMALL_CHAT_DEPLOYMENT=gpt-5-nano
EMBEDDING_DEPLOYMENT=text-embedding-3-small
ANALYZER_ID=damage-triage-v1
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
SEARCH_INDEX=manuals
COSMOS_ENDPOINT=https://<cosmos-account>.documents.azure.com:443/
COSMOS_DATABASE=fieldops
MANUALS_CONTAINER_URL=https://<storage-account>.blob.core.windows.net/manuals
STORAGE_ACCOUNT_RESOURCE_ID=/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/<group>/providers/Microsoft.Storage/storageAccounts/<storage-account>
EVENT_GRID_TOPIC_ENDPOINT=
INVENTORY_MCP_URL=http://localhost:8020/mcp
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
API_AUDIENCE=api://<api-app-registration-client-id>
API_APP_ROLE=Copilot.Use
A2A_APP_ROLE=Copilot.Diagnose
SUPERVISOR_ROLE=supervisor
REQUIRE_AUTH=false
APPLICATIONINSIGHTS_CONNECTION_STRING=
SIMILAR_CASES=5
MAX_PART_QUANTITY=50
